{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Synapse",
  "version": "2.0.3",
  "identifier": "com.synapse.hub",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Synapse",
        "width": 660,
        "height": 980,
        "minWidth": 560,
        "minHeight": 520,
        "resizable": true,
        "theme": "Dark",
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ]
  }
}
